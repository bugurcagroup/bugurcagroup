rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    match /products/{allPaths=**} {
      allow read: if true;
    }

    match /products/{dealerId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (isAdmin() || (
          hasRole('bayi')
          && firestore.exists(/databases/(default)/documents/dealers/$(dealerId))
          && (
            firestore.get(/databases/(default)/documents/dealers/$(dealerId)).data.userId == request.auth.uid
            || firestore.get(/databases/(default)/documents/dealers/$(dealerId)).data.email == request.auth.token.email
          )
        ));
    }

    match /settings/brands/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 15 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /receipts/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
